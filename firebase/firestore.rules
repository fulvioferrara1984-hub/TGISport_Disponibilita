rules_version = '2';

// Disponibilità Ops · TGI Sport — chi può leggere e scrivere cosa.
// Supervisori: gli account con le email qui sotto (le stesse di SUPERVISORI in app/config.js),
// solo dopo aver confermato l'indirizzo con il link ricevuto per email.
// Operatori: un account per codice; utenti/{uid} dice a quale operatore appartiene.
// Cambiare codice o disattivare un operatore toglie l'accesso subito, perché ogni regola lo ricontrolla.

service cloud.firestore {
  match /databases/{database}/documents {

    function supervisore() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'fferrara@tgisport.com',
          'spedatella@tgisport.com',
          'fgennaro@tgisport.com',
          'ssolera@tgisport.com'
        ];
    }
    // Colleghi in sola visualizzazione: email confermata e presente in visualizzatori/{email} (lo gestiscono i supervisori).
    // Leggono solo ciò che serve a Convocazioni, Riepilogo e Operatori; non scrivono nulla.
    function visualizzatore() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/visualizzatori/$(request.auth.token.email));
    }
    function lettore() {
      return supervisore() || visualizzatore();
    }
    function abbinamento() {
      return /databases/$(database)/documents/utenti/$(request.auth.uid);
    }
    function mioOperatore() {
      return get(abbinamento()).data.operatoreId;
    }
    // l'utente è l'operatore {id}, e quell'operatore è attivo
    function operatoreAttivo(id) {
      return request.auth != null && exists(abbinamento()) && mioOperatore() == id
        && get(/databases/$(database)/documents/operatori/$(id)).data.attivo == true;
    }
    function operatore() {
      return request.auth != null && exists(abbinamento()) && operatoreAttivo(mioOperatore());
    }
    // data dell'evento (stringa yyyy-mm-dd) come istante, per la finestra di blocco
    function dataEvento() {
      let p = resource.data.data.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    // giorni di blocco impostati dai supervisori (3 se non ancora impostati)
    function giorniBlocco() {
      let rif = /databases/$(database)/documents/impostazioni/operativo;
      return exists(rif) ? get(rif).data.get('giorniBlocco', 3) : 3;
    }

    // Deployment on-site: l'operatore vede solo quelli mandati a lui
    // e può solo occupare un posto del suo ruolo o dire che non può.
    function abilitazioneOnsite() {
      return get(/databases/$(database)/documents/operatori/$(mioOperatore())).data.get('onsite', '');
    }
    function primoGiornoOnsite() {
      let p = resource.data.da.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    function puoRispondereOnsite() {
      let io = mioOperatore();
      return operatore() && resource.data.stato == 'aperta' && request.time < primoGiornoOnsite()
        && io in resource.data.destinatari && !(io in resource.data.esclusi)
        && !(io in resource.data.accettatiTL) && !(io in resource.data.accettatiOP);
    }
    function accettaOnsite() {
      let io = mioOperatore();
      let ruolo = abilitazioneOnsite();
      return puoRispondereOnsite() && ruolo in ['TL', 'OP']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accettati' + ruolo, 'rifiuti'])
        && request.resource.data['accettati' + ruolo] == resource.data['accettati' + ruolo].concat([io])
        && request.resource.data['accettati' + ruolo].size() <= resource.data.posti[ruolo]
        && request.resource.data.rifiuti == resource.data.rifiuti.removeAll([io]);
    }
    function nonPossoOnsite() {
      let io = mioOperatore();
      return puoRispondereOnsite() && !(io in resource.data.rifiuti)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rifiuti'])
        && request.resource.data.rifiuti == resource.data.rifiuti.concat([io]);
    }
    // Richieste di disponibilità per un evento: l'operatore risponde Sì/No solo per sé,
    // con la richiesta aperta e fino alla fine del giorno della partita (anche dentro la finestra di blocco).
    function rispostaEvento() {
      let io = mioOperatore();
      let p = resource.data.evento.data.split('-');
      return operatore() && resource.data.aperta == true && io in resource.data.destinatari
        && request.time < timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(1, 'd')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['risposte'])
        && request.resource.data.risposte.diff(resource.data.risposte).affectedKeys().hasOnly([io])
        && request.resource.data.risposte[io].keys().hasOnly(['r', 'il'])
        && request.resource.data.risposte[io].r in ['si', 'no']
        && request.resource.data.risposte[io].il == request.time;
    }

    match /utenti/{uid} {
      allow read: if supervisore() || (request.auth != null && request.auth.uid == uid);
      allow write: if supervisore();
    }

    match /operatori/{id} {
      allow read: if lettore() || operatoreAttivo(id);
      allow create, delete: if supervisore();
      // l'operatore può aggiornare solo la data del suo ultimo invio
      allow update: if supervisore()
        || (operatoreAttivo(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoInvio']));
    }

    match /disponibilita/{id} {
      allow read: if lettore() || operatoreAttivo(id);
      allow create, update: if (supervisore() || operatoreAttivo(id))
        && request.resource.data.keys().hasOnly(['giorni']) && request.resource.data.giorni is map;
      allow delete: if supervisore();
    }

    match /invii/{invio} {
      allow read, delete: if supervisore();
      // i supervisori possono solo segnarli come letti
      allow update: if supervisore() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letto']);
      allow create: if operatore()
        && request.resource.data.keys().hasOnly(['quando', 'operatoreId', 'nome', 'modifiche', 'letto', 'tipo', 'evento'])
        && request.resource.data.operatoreId == mioOperatore()
        && request.resource.data.letto == false
        && request.resource.data.modifiche is list;
    }

    match /richieste/{richiesta} {
      allow read: if supervisore() || operatore();
      allow write: if supervisore();
    }

    // Eventi e turni: l'operatore vede solo le proprie convocazioni già inviate,
    // e può soltanto confermarle o rifiutarle. Rifiutare si può solo una convocazione in attesa
    // e fuori dalla finestra di blocco; dopo, si telefona al supervisore.
    match /eventi/{evento} {
      allow read: if lettore()
        || (operatore() && resource.data.operatoreId == mioOperatore() && resource.data.inviata == true);
      allow create, delete: if supervisore();
      allow update: if supervisore()
        || (operatore() && resource.data.operatoreId == mioOperatore() && resource.data.inviata == true
          && resource.data.stato != 'annullato'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'risposta', 'rispostaIl'])
          && (request.resource.data.stato == 'confermato'
            || (request.resource.data.stato == 'rifiutato' && resource.data.stato == 'convocato'
              && request.time < dataEvento() - duration.value(giorniBlocco(), 'd'))));
    }

    // Tariffe, competizioni e regole: solo i supervisori (gli operatori non vedono i compensi).
    // "operativo" (telefono di reperibilità e giorni di blocco) lo leggono anche gli operatori attivi.
    match /onsite/{id} {
      allow read: if lettore() || (operatore() && mioOperatore() in resource.data.destinatari);
      allow create, delete: if supervisore();
      allow update: if supervisore() || accettaOnsite() || nonPossoOnsite();
    }

    // compenso del deployment: solo i supervisori
    match /onsiteRiservato/{id} {
      allow read: if lettore();
      allow write: if supervisore();
    }

    // l'operatore vede solo le richieste mandate a lui (le letture filtrano per destinatari)
    match /richiesteEvento/{id} {
      allow read: if lettore() || (operatore() && mioOperatore() in resource.data.destinatari);
      allow create, delete: if supervisore();
      allow update: if supervisore() || rispostaEvento();
    }

    // elenco dei colleghi in sola visualizzazione: id = email in minuscolo
    match /visualizzatori/{email} {
      allow read: if supervisore()
        || (request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == email);
      allow create, update: if supervisore() && request.resource.data.keys().hasOnly(['email', 'aggiunto', 'da'])
        && request.resource.data.keys().hasAll(['email', 'aggiunto', 'da']) && request.resource.data.email == email;
      allow delete: if supervisore();
    }

    match /impostazioni/{documento} {
      allow read: if supervisore() || (documento == 'operativo' && operatore())
        || (visualizzatore() && documento in ['regole', 'operativo']);
      allow write: if supervisore();
    }
  }
}
